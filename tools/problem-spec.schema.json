{
  "$id": "https://spec.company/nlu/problem-spec.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProblemSpec",
  "type": "object",
  "required": [
    "class",
    "confidence",
    "inputs",
    "outputs"
  ],
  "properties": {
    "class": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "array"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array"
    }
  }
}